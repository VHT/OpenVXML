library "vxml-shared-library"

def WIN_LABEL    = '2019CoreBuild'
def LINUX_LABEL  = 'docker'
def MAVEN_IMAGE  = 'maven:3.6.0-amazoncorretto-8'
def FILE_IP      = env.FILE_SERVER
def PUBLISH_ROOT = "\\\\${FILE_IP}\\u\\VXML_Builds"
def SMB_CRED_ID  = 'windows_admin_login'

def ensureFileServer(String ip, String credId) {
    def existing = bat(script: '@net use', returnStdout: true)
    if (existing.contains(ip)) {
        echo "Reusing existing connection to ${ip}"
    } else {
        withCredentials([usernamePassword(credentialsId: credId, usernameVariable: 'SMB_USER', passwordVariable: 'SMB_PASS')]) {
            bat "net use \\\\${ip}\\IPC\$ \"%SMB_PASS%\" /user:\"%SMB_USER%\""
        }
    }
}

timestamps {
    def gitURLOpenVXML = 'https://github.com/VHT/OpenVXML.git'
    def buildLocation = "${PUBLISH_ROOT}\\OpenVXML_Builds\\OpenVXML_${env.OPENVXML_VERSION_NUMBER}.${env.BUILD_NUMBER}"
    def branch = env.CHANGE_TARGET
    def manifestFile = 'OpenVXML_manifest.json'
    if(branch == null){
        echo "branch name assignment"
        branch = env.BRANCH_NAME
    }else{
        echo "target branch assignment in pull request"
        branch = env.CHANGE_BRANCH
    }
    echo "Branch Name: ${branch}"
    if(branch != "master")
    buildLocation = "${PUBLISH_ROOT}\\OpenVXML_Builds\\BranchBuilds\\OpenVXML_${branch}\\OpenVXML_${branch}_${env.OPENVXML_VERSION_NUMBER}.${env.BUILD_NUMBER}"

    node (LINUX_LABEL) {
        deleteDir()
        stage("Git Checkout"){
            checkoutSourceCode(gitURLOpenVXML,env.GIT_CREDENTIALS,branch)
        }
        stage ('Build') {
            docker.image(MAVEN_IMAGE).inside {

                // Run the maven build
                withCredentials([usernamePassword(credentialsId: 'prem_artifactory_creds', usernameVariable: 'ARTIFACTORY_USER', passwordVariable: 'ARTIFACTORY_TOKEN')]) {
                    sh """
                    mvn -B -Dmaven.repo.local=${WORKSPACE}/.m2 clean verify
                    mkdir -p ${WORKSPACE}/OpenVXML/repository
                    cp -r com.vht.openvxml.releng/com.vht.openvxml.update/target/repository/ ${WORKSPACE}/OpenVXML/
                """
                }
            }
            stash includes: 'OpenVXML/**', name: 'OpenVXML'
        }
        stage ('Create manifest file') {
            createManifest('OpenVXML', gitURLOpenVXML, env.GIT_CREDENTIALS, manifestFile)
            stash includes: "${manifestFile}", name: 'ManifestJson'
        }
    }

    node (WIN_LABEL) {
        deleteDir()
        stage ('Publish') {
            unstash 'OpenVXML'
            ensureFileServer(FILE_IP, SMB_CRED_ID)
            powershell """
                robocopy "\$env:WORKSPACE\\OpenVXML" "${buildLocation}" /E /R:2 /W:5 /NP /NFL /NDL
                if (\$LASTEXITCODE -ge 8) { throw "robocopy of OpenVXML failed (exit \$LASTEXITCODE) to ${buildLocation}" }
                exit 0
            """
        }
        stage ('Publish Manifest Json') {
            unstash 'ManifestJson'
            powershell """
                robocopy "\$env:WORKSPACE" "${buildLocation}" ${manifestFile} /R:2 /W:5 /NP /NFL /NDL
                if (\$LASTEXITCODE -ge 8) { throw "robocopy of manifest failed (exit \$LASTEXITCODE) to ${buildLocation}" }
                exit 0
            """
        }
    }
}
